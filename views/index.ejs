<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>szallas</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <main class="container mt-4">
    <h1>Szallasfoglalas</h1>

    <p>Jelenlegi foglalasok szama: <%= darab %></p>

    <% if (hibak.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% for (const hiba of hibak) { %>
            <li><%= hiba %></li>
          <% } %>
        </ul>
      </div>
    <% } %>

    <% if (siker) { %>
      <div class="alert alert-success">
        <%= siker %>
      </div>
    <% } %>

    <form action="/" method="post" novalidate>
      <div class="mb-3">
        <label for="name" class="form-label">Nev</label>
        <input type="text" id="name" name="name" class="form-control" value="<%= adatok.name %>" maxlength="100" required>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email cim</label>
        <input type="text" id="email" name="email" class="form-control" value="<%= adatok.email %>" maxlength="100" required>
      </div>

      <div class="mb-3">
        <label for="startDate" class="form-label">
          Datum es idopont
        </label>
        <input type="datetime-local" id="startDate" name="startDate" class="form-control" value="<%= adatok.startDate %>" required>
      </div>

      <div class="mb-3">
        <label for="guests" class="form-label">
          Vendegek szama
        </label>
        <input type="number" id="guests" name="guests" class="form-control" value="<%= adatok.guests %>" min="1" max="10" step="1" required>
      </div>

      <button type="submit" class="btn btn-primary">
        Foglalas
      </button>
    </form>
  </main>
</body>
</html>